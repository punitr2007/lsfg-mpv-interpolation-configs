#!/usr/bin/env bash
# ==============================================================================
# lsfg — Lossless Scaling Frame Generation Launcher Wrapper for mpv & Linux
# ==============================================================================
#
# Description:
#   Launches mpv (or any custom command) with Lossless Scaling Frame Generation
#   (lsfg-vk v2) seamlessly on Linux (Arch Linux / Wayland & X11 / NVIDIA & AMD).
#
# Usage:
#   lsfg [options] <command> [args...]
#   lsfg [options] mpv /path/to/video.mkv
#   lsfg [options] yt "https://youtube.com/watch?v=..."
#
# Options:
#   -m, --multiplier X    Set FPS multiplier (2, 3, 4) [default: 3]
#   -f, --flow-scale X    Set optical flow scale (0.25 to 1.0) [default: 1.0]
#   -p, --performance     Toggle performance mode (reduces GPU load)
#   --pacing MODE         Set pacing mode (vsync) [default: vsync]
#   --dll PATH            Override path to lsfg-vk.dll or Lossless.dll
#   -d, --debug           Enable verbose debug logging (LSFGVK_LOG_LEVEL=debug)
#   --help                Show this help message
#
# ==============================================================================

set -euo pipefail

# ── Colors & Styles ───────────────────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

# ── Paths & Locations ──────────────────────────────────────────────────────────
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/lsfg-vk"
CONFIG_FILE="${CONFIG_DIR}/conf.toml"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}"
V1_LAYER_JSON="${DATA_DIR}/vulkan/implicit_layer.d/VkLayer_LS_frame_generation.json"

mkdir -p "${CONFIG_DIR}"

# Common Steam library search locations for lsfg-vk.dll and Lossless.dll
CANDIDATE_DLLS=(
    # v2 Native Shader DLL (from Steam Beta branch 'lsfg-vk')
    "${HOME}/.local/share/Steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    "${HOME}/.steam/steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    "${HOME}/.steam/root/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    "/mnt/storage/SteamLibrary/steamapps/common/Lossless Scaling/lsfg-vk.dll"
    "${HOME}/Local_Codebase/Projects/Lossless Scaling/lsfg-vk.dll"

    # Standard Lossless.dll fallback
    "${HOME}/.local/share/Steam/steamapps/common/Lossless Scaling/Lossless.dll"
    "${HOME}/.steam/steam/steamapps/common/Lossless Scaling/Lossless.dll"
    "${HOME}/.steam/root/steamapps/common/Lossless Scaling/Lossless.dll"
    "${HOME}/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/Lossless Scaling/Lossless.dll"
    "/mnt/storage/SteamLibrary/steamapps/common/Lossless Scaling/Lossless.dll"
    "${HOME}/Local_Codebase/Projects/Lossless Scaling/Lossless.dll"
)

# ── Locate DLL ────────────────────────────────────────────────────────────────
DETECTED_DLL=""
for dll in "${CANDIDATE_DLLS[@]}"; do
    if [[ -f "$dll" ]]; then
        DETECTED_DLL="$dll"
        break
    fi
done

# ── Ensure Default conf.toml (v2 Format) ──────────────────────────────────────
ensure_v2_config() {
    local target_dll="${1:-}"
    if [[ ! -f "${CONFIG_FILE}" ]]; then
        cat << TOML > "${CONFIG_FILE}"
version = 2

[global]
dll = "${target_dll}"
allow_fp16 = true
log_level = "info"

[[profile]]
name = "mpv"
active_in = ["mpv"]
multiplier = 3
flow_scale = 1.0
performance_mode = false
pacing_mode = "vsync"
override_present_mode = true
TOML
    elif grep -q "^version = 1" "${CONFIG_FILE}" 2>/dev/null; then
        echo -e "${YELLOW}[lsfg] Notice: Migrating legacy conf.toml (version 1) to modern version 2 schema...${NC}"
        cp -f "${CONFIG_FILE}" "${CONFIG_FILE}.v1.bak"
        cat << TOML > "${CONFIG_FILE}"
version = 2

[global]
dll = "${target_dll}"
allow_fp16 = true
log_level = "info"

[[profile]]
name = "mpv"
active_in = ["mpv"]
multiplier = 3
flow_scale = 1.0
performance_mode = false
pacing_mode = "vsync"
override_present_mode = true
TOML
        echo -e "${GREEN}[lsfg] ✓ Upgraded ${CONFIG_FILE} to v2 (backup: conf.toml.v1.bak)${NC}"
    fi
}

ensure_v2_config "${DETECTED_DLL}"

# ── Configuration State Tracking ──────────────────────────────────────────────
MULTIPLIER="3"
FLOW_SCALE="1.0"
PERF_MODE="false"
PACING_MODE="vsync"
LOG_LEVEL="info"
OVERRIDE_DLL=""

# Read current multiplier / flow_scale from conf.toml if present
if [[ -f "${CONFIG_FILE}" ]]; then
    if grep -qE "multiplier\s*=" "${CONFIG_FILE}"; then
        MULTIPLIER=$(grep -E "multiplier\s*=" "${CONFIG_FILE}" | head -n1 | sed -E 's/.*=\s*([0-9]+).*/\1/')
    fi
    if grep -qE "flow_scale\s*=" "${CONFIG_FILE}"; then
        FLOW_SCALE=$(grep -E "flow_scale\s*=" "${CONFIG_FILE}" | head -n1 | sed -E 's/.*=\s*([0-9.]+).*/\1/')
    fi
    if grep -qE "performance_mode\s*=\s*true" "${CONFIG_FILE}"; then
        PERF_MODE="true"
    fi
    if grep -qE "dll\s*=" "${CONFIG_FILE}"; then
        CONFIG_DLL=$(grep -E "dll\s*=" "${CONFIG_FILE}" | head -n1 | sed -E 's/.*=\s*["'\''"]([^"'\'']+)["'\''"].*/\1/')
        if [[ -n "${CONFIG_DLL}" && -f "${CONFIG_DLL}" ]]; then
            DETECTED_DLL="${CONFIG_DLL}"
        fi
    fi
fi

# ── Update Profile Field Helper ───────────────────────────────────────────────
update_profile_field() {
    local field="$1"
    local value="$2"
    if [[ -f "${CONFIG_FILE}" ]]; then
        # Use python if available for clean TOML update, else fallback to awk
        if command -v python3 >/dev/null 2>&1; then
            python3 -c "
import re, sys
path = sys.argv[1]
field = sys.argv[2]
val = sys.argv[3]
try:
    with open(path, 'r') as f:
        content = f.read()
    # Check if value is boolean or number
    if val in ['true', 'false']:
        replacement = f'{field} = {val}'
    elif re.match(r'^[0-9]+(\.[0-9]+)?$', val):
        replacement = f'{field} = {val}'
    else:
        replacement = f'{field} = \"{val}\"'
    new_content = re.sub(rf'(?m)^(\s*{field}\s*=).*$', replacement, content)
    with open(path, 'w') as f:
        f.write(new_content)
except Exception:
    pass
" "${CONFIG_FILE}" "${field}" "${value}" 2>/dev/null || true
        else
            awk -v field="$field" -v value="$value" '
                $0 ~ "^[[:space:]]*" field "[[:space:]]*=" {
                    sub(/=.*/, "= " value)
                }
                { print }
            ' "${CONFIG_FILE}" > /tmp/lsfg_conf_tmp && mv /tmp/lsfg_conf_tmp "${CONFIG_FILE}"
        fi
    fi
}

# ── Argument Parsing ──────────────────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--multiplier)
            MULTIPLIER="$2"
            update_profile_field "multiplier" "$MULTIPLIER"
            echo -e "${GREEN}[lsfg]${NC} Multiplier -> ${BOLD}${MULTIPLIER}x${NC}"
            shift 2
            ;;
        -f|--flow-scale)
            FLOW_SCALE="$2"
            update_profile_field "flow_scale" "$FLOW_SCALE"
            echo -e "${GREEN}[lsfg]${NC} Flow Scale -> ${BOLD}${FLOW_SCALE}${NC}"
            shift 2
            ;;
        -p|--performance)
            if [[ "$PERF_MODE" == "true" ]]; then
                PERF_MODE="false"
                update_profile_field "performance_mode" "false"
                echo -e "${GREEN}[lsfg]${NC} Performance Mode -> ${BOLD}false (Quality)${NC}"
            else
                PERF_MODE="true"
                update_profile_field "performance_mode" "true"
                echo -e "${GREEN}[lsfg]${NC} Performance Mode -> ${BOLD}true (Power Save)${NC}"
            fi
            shift 1
            ;;
        --pacing)
            PACING_MODE="$2"
            update_profile_field "pacing_mode" "$PACING_MODE"
            echo -e "${GREEN}[lsfg]${NC} Pacing Mode -> ${BOLD}${PACING_MODE}${NC}"
            shift 2
            ;;
        -d|--debug)
            LOG_LEVEL="debug"
            echo -e "${GREEN}[lsfg]${NC} Debug Logging -> ${BOLD}Enabled${NC}"
            shift 1
            ;;
        --dll)
            OVERRIDE_DLL="$2"
            DETECTED_DLL="$2"
            update_profile_field "dll" "\"${DETECTED_DLL}\""
            echo -e "${GREEN}[lsfg]${NC} DLL Override -> ${BOLD}${DETECTED_DLL}${NC}"
            shift 2
            ;;
        --help)
            echo "Lossless Scaling Frame Generation Launcher (lsfg)"
            echo "Usage: lsfg [options] <command> [args...]"
            echo ""
            echo "Options:"
            echo "  -m, --multiplier 2|3|4    Target frame multiplier (e.g. 24fps -> 72fps with -m 3)"
            echo "  -f, --flow-scale SCALE    Optical flow scale (0.25 to 1.0) [default: 1.0]"
            echo "  -p, --performance         Toggle lightweight performance mode (reduces GPU load)"
            echo "  --pacing MODE             Frame pacing mode (vsync) [default: vsync]"
            echo "  --dll PATH                Specify custom path to lsfg-vk.dll or Lossless.dll"
            echo "  -d, --debug               Enable verbose debug logging (LSFGVK_LOG_LEVEL=debug)"
            echo "  --help                    Show this help message"
            echo ""
            echo "Examples:"
            echo "  lsfg mpv video.mkv"
            echo "  lsfg -m 3 -f 1.0 mpv movie.webm"
            echo "  lsfg -m 4 -f 1.0 mpv anime.mkv"
            echo "  lsfg yt \"https://youtu.be/...\""
            exit 0
            ;;
        -*)
            echo -e "${RED}[lsfg] ERROR: Unknown option: $1${NC}"
            echo "Run 'lsfg --help' for usage."
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ $# -eq 0 ]]; then
    echo "Usage: lsfg [options] <command> [args...]"
    echo "Run 'lsfg --help' for details."
    exit 1
fi

# ── DLL Verification & Guidance ───────────────────────────────────────────────
FINAL_DLL="${OVERRIDE_DLL:-$DETECTED_DLL}"

if [[ -z "${FINAL_DLL}" || ! -f "${FINAL_DLL}" ]]; then
    echo -e "${YELLOW}[lsfg] WARNING: Neither lsfg-vk.dll nor Lossless.dll could be automatically located.${NC}"
    echo "Please ensure Lossless Scaling is installed on Steam, or specify --dll /path/to/lsfg-vk.dll"
fi

if [[ -n "${FINAL_DLL}" && "$(basename "${FINAL_DLL}")" == "Lossless.dll" ]]; then
    # Check if lsfg-vk.dll sits next to it
    DIR_NAME="$(dirname "${FINAL_DLL}")"
    if [[ -f "${DIR_NAME}/lsfg-vk.dll" ]]; then
        FINAL_DLL="${DIR_NAME}/lsfg-vk.dll"
        echo -e "${GREEN}[lsfg] Auto-selected native v2 shader library:${NC} ${FINAL_DLL}"
    else
        echo -e "${BLUE}[lsfg] Notice:${NC} Using ${FINAL_DLL}."
        echo -e "       ${YELLOW}For best results with lsfg-vk v2, switch Lossless Scaling to the 'lsfg-vk' Beta branch in Steam:${NC}"
        echo -e "       Steam Library -> Right Click 'Lossless Scaling' -> Properties -> Betas -> Select 'lsfg-vk'\n"
    fi
fi

# ── Environment & Vulkan Layer Setup ──────────────────────────────────────────
# 1. CRITICAL: Unset any suppression of the modern v2 layer
unset DISABLE_LSFGVK 2>/dev/null || true
export DISABLE_LSFGVK=0

# 2. Suppress obsolete/conflicting v1 implicit layer to prevent dual-layer loader collision
export DISABLE_LSFG=1

# 3. Modern v2 Layer Environment Controls (lsfg-vk v2)
export LSFGVK_PROFILE="mpv"
export LSFGVK_CONFIG="${CONFIG_FILE}"
export LSFGVK_MULTIPLIER="${MULTIPLIER}"
export LSFGVK_FLOW_SCALE="${FLOW_SCALE}"
export LSFGVK_PERFORMANCE_MODE="${PERF_MODE}"
export LSFGVK_PACING_MODE="${PACING_MODE}"
export LSFGVK_OVERRIDE_PRESENT_MODE="true"
export LSFGVK_LOG_LEVEL="${LOG_LEVEL}"

if [[ -n "${FINAL_DLL}" && -f "${FINAL_DLL}" ]]; then
    export LSFGVK_DLL_PATH="${FINAL_DLL}"
fi

# 4. Backward compatibility variables (for v1 legacy builds)
export LSFG_MULTIPLIER="${MULTIPLIER}"
export LSFG_FLOW_SCALE="${FLOW_SCALE}"
export LSFG_PERFORMANCE_MODE="${PERF_MODE}"
if [[ -n "${FINAL_DLL}" ]]; then
    export LSFG_DLL_PATH="${FINAL_DLL}"
fi

# ── Hardware Decoding Configuration ───────────────────────────────────────────
HWDEC_FLAG="nvdec-copy"
if command -v nvidia-smi >/dev/null 2>&1; then
    HWDEC_FLAG="nvdec-copy"
elif command -v vainfo >/dev/null 2>&1; then
    HWDEC_FLAG="vaapi-copy"
else
    HWDEC_FLAG="auto-safe"
fi

# ── Launch Target ─────────────────────────────────────────────────────────────
if [[ "$1" == "yt" || "$1" == "youtube" ]]; then
    shift
    exec mpv \
        --vo=gpu-next \
        --gpu-api=vulkan \
        --hwdec="${HWDEC_FLAG}" \
        --hwdec-codecs=all \
        --interpolation=no \
        --video-sync=audio \
        --profile=lsfg \
        --ytdl=yes \
        --cache=yes \
        --cache-secs=120 \
        "$@"

elif [[ "$1" == "mpv" ]]; then
    shift
    exec mpv \
        --vo=gpu-next \
        --gpu-api=vulkan \
        --hwdec="${HWDEC_FLAG}" \
        --hwdec-codecs=all \
        --interpolation=no \
        --video-sync=audio \
        --profile=lsfg \
        "$@"
else
    exec "$@"
fi
